<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd" version="3.1">
<display-name>Automobile Production Data Security v2.0</display-name>
<welcome-file-list>
<welcome-file>home.jsp</welcome-file>
<welcome-file>index.jsp</welcome-file>
</welcome-file-list>
<filter>
<filter-name>AuthFilter</filter-name>
<filter-class>com.automobile.filter.AuthFilter</filter-class>
</filter>
<filter-mapping>
<filter-name>AuthFilter</filter-name>
<url-pattern>/*</url-pattern>
</filter-mapping>
<!--   LoginServlet   -->
<servlet>
<servlet-name>LoginServlet</servlet-name>
<servlet-class>com.automobile.servlet.LoginServlet</servlet-class>
</servlet>
<servlet-mapping>
<servlet-name>LoginServlet</servlet-name>
<url-pattern>/login</url-pattern>
</servlet-mapping>
<!--   LogoutServlet   -->
<servlet>
<servlet-name>LogoutServlet</servlet-name>
<servlet-class>com.automobile.servlet.LogoutServlet</servlet-class>
</servlet>
<servlet-mapping>
<servlet-name>LogoutServlet</servlet-name>
<url-pattern>/logout</url-pattern>
</servlet-mapping>
<!--   VehicleServlet   -->
<servlet>
<servlet-name>VehicleServlet</servlet-name>
<servlet-class>com.automobile.servlet.VehicleServlet</servlet-class>
</servlet>
<servlet-mapping>
<servlet-name>VehicleServlet</servlet-name>
<url-pattern>/vehicle</url-pattern>
</servlet-mapping>
<!--   QCServlet - multipart for photo upload   -->
<servlet>
<servlet-name>QCServlet</servlet-name>
<servlet-class>com.automobile.servlet.QCServlet</servlet-class>
<multipart-config>
<max-file-size>5242880</max-file-size>
<max-request-size>10485760</max-request-size>
<file-size-threshold>1048576</file-size-threshold>
</multipart-config>
</servlet>
<servlet-mapping>
<servlet-name>QCServlet</servlet-name>
<url-pattern>/qc</url-pattern>
</servlet-mapping>
<!--   TestingServlet   -->
<servlet>
<servlet-name>TestingServlet</servlet-name>
<servlet-class>com.automobile.servlet.TestingServlet</servlet-class>
</servlet>
<servlet-mapping>
<servlet-name>TestingServlet</servlet-name>
<url-pattern>/testing</url-pattern>
</servlet-mapping>
<!--   WorkflowServlet   -->
<servlet>
<servlet-name>WorkflowServlet</servlet-name>
<servlet-class>com.automobile.servlet.WorkflowServlet</servlet-class>
</servlet>
<!--   CustomerLoginServlet   -->
<servlet>
<servlet-name>CustomerLoginServlet</servlet-name>
<servlet-class>com.automobile.servlet.CustomerLoginServlet</servlet-class>
</servlet>
<!--   CustomerLogoutServlet   -->
<servlet>
<servlet-name>CustomerLogoutServlet</servlet-name>
<servlet-class>com.automobile.servlet.CustomerLogoutServlet</servlet-class>
</servlet>
<!--   CustomerRegisterServlet   -->
<servlet>
<servlet-name>CustomerRegisterServlet</servlet-name>
<servlet-class>com.automobile.servlet.CustomerRegisterServlet</servlet-class>
</servlet>
<!--   VerifyOtpServlet   -->
<servlet>
<servlet-name>VerifyOtpServlet</servlet-name>
<servlet-class>com.automobile.servlet.VerifyOtpServlet</servlet-class>
</servlet>
<!--   SubmitRequirementServlet - multipart for file attachment   -->
<servlet>
<servlet-name>SubmitRequirementServlet</servlet-name>
<servlet-class>com.automobile.servlet.SubmitRequirementServlet</servlet-class>
<multipart-config>
<max-file-size>10485760</max-file-size>
<max-request-size>15728640</max-request-size>
<file-size-threshold>1048576</file-size-threshold>
</multipart-config>
</servlet>
<!--   SubmitBulkOrderServlet - multipart for contract file   -->
<servlet>
<servlet-name>SubmitBulkOrderServlet</servlet-name>
<servlet-class>com.automobile.servlet.SubmitBulkOrderServlet</servlet-class>
<multipart-config>
<max-file-size>10485760</max-file-size>
<max-request-size>15728640</max-request-size>
<file-size-threshold>1048576</file-size-threshold>
</multipart-config>
</servlet>
<!--   save_qc_work.jsp - multipart for form fields + photo   -->
<servlet>
<servlet-name>SaveQcWork</servlet-name>
<jsp-file>/jsp/save_qc_work.jsp</jsp-file>
<multipart-config>
<max-file-size>10485760</max-file-size>
<max-request-size>20971520</max-request-size>
<file-size-threshold>1048576</file-size-threshold>
</multipart-config>
</servlet>
<servlet-mapping>
<servlet-name>SaveQcWork</servlet-name>
<url-pattern>/jsp/save_qc_work.jsp</url-pattern>
</servlet-mapping>
<!--   save_design_work.jsp - multipart for blueprint/3D file uploads   -->
<servlet>
<servlet-name>SaveDesignWork</servlet-name>
<jsp-file>/jsp/save_design_work.jsp</jsp-file>
<multipart-config>
<max-file-size>20971520</max-file-size>
<max-request-size>41943040</max-request-size>
<file-size-threshold>1048576</file-size-threshold>
</multipart-config>
</servlet>
<servlet-mapping>
<servlet-name>SaveDesignWork</servlet-name>
<url-pattern>/jsp/save_design_work.jsp</url-pattern>
</servlet-mapping>
<!--   save_qc_draft.jsp - multipart for QC doc file uploads   -->
<servlet>
<servlet-name>SaveQcDraft</servlet-name>
<jsp-file>/jsp/save_qc_draft.jsp</jsp-file>
<multipart-config>
<max-file-size>10485760</max-file-size>
<max-request-size>20971520</max-request-size>
<file-size-threshold>1048576</file-size-threshold>
</multipart-config>
</servlet>
<servlet-mapping>
<servlet-name>SaveQcDraft</servlet-name>
<url-pattern>/jsp/save_qc_draft.jsp</url-pattern>
</servlet-mapping>
<!--   save_analytics_work.jsp   -->
<servlet>
<servlet-name>SaveAnalyticsWork</servlet-name>
<jsp-file>/jsp/save_analytics_work.jsp</jsp-file>
</servlet>
<servlet-mapping>
<servlet-name>SaveAnalyticsWork</servlet-name>
<url-pattern>/jsp/save_analytics_work.jsp</url-pattern>
</servlet-mapping>
<!--   save_testing_work.jsp - multipart for test photo upload   -->
<servlet>
<servlet-name>SaveTestingWork</servlet-name>
<jsp-file>/jsp/save_testing_work.jsp</jsp-file>
<multipart-config>
<max-file-size>10485760</max-file-size>
<max-request-size>20971520</max-request-size>
<file-size-threshold>1048576</file-size-threshold>
</multipart-config>
</servlet>
<servlet-mapping>
<servlet-name>SaveTestingWork</servlet-name>
<url-pattern>/jsp/save_testing_work.jsp</url-pattern>
</servlet-mapping>
<!--   Session timeout: 30 minutes   -->
<session-config>
<session-timeout>30</session-timeout>
</session-config>
</web-app>