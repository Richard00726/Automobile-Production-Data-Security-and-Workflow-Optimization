<?xml version="1.0" encoding="UTF-8"?>
<!--
  .project — Eclipse Project Descriptor
  ======================================
  This file defines the Eclipse project identity and build configuration.
  It MUST be present at the root of your project folder.

  KEY ELEMENTS:
  - <name>       : The project name shown in Eclipse's Package Explorer.
  - <natures>    : Tell Eclipse what KIND of project this is.
                   "javanature"  → enables Java compiler and JDT tooling.
                   "faceted"     → enables the Faceted Project Framework
                                   (required for Dynamic Web Projects).
  - <buildSpec>  : Defines which Eclipse "builders" run on this project.
                   "javabuilder" → compiles .java files to .class files.
                   "FacetedProjectValidator" / "ValidationBuilder"
                                 → runs Eclipse validators (XML, JSP, etc).

  HOW TO IMPORT INTO ECLIPSE OXYGEN:
    File → Import → General → Existing Projects into Workspace
    → Select root folder of this project → Finish
-->
<projectDescription>
    <name>AutomobileApp</name>
    <comment>Automobile Production Data Security — Eclipse Dynamic Web Project</comment>
    <projects/>

    <buildSpec>

        <!-- Java Builder: compiles all .java source files under src/ -->
        <buildCommand>
            <name>org.eclipse.jdt.core.javabuilder</name>
            <arguments/>
        </buildCommand>

        <!-- Faceted Project Validator: validates facet constraints (e.g. Java EE version) -->
        <buildCommand>
            <name>org.eclipse.wst.common.project.facet.core.builder</name>
            <arguments/>
        </buildCommand>

        <!-- Validation Builder: validates XML, JSP, web.xml, etc. -->
        <buildCommand>
            <name>org.eclipse.wst.validation.validationbuilder</name>
            <arguments/>
        </buildCommand>

    </buildSpec>

    <natures>
        <!-- Java Nature: enables Java Development Tools (JDT) for this project -->
        <nature>org.eclipse.jdt.core.javanature</nature>

        <!-- Faceted Project Nature: enables Dynamic Web Project support -->
        <nature>org.eclipse.wst.common.project.facet.core.nature</nature>

        <!-- Module Core Nature: enables WTP module / deployment descriptor support -->
        <nature>org.eclipse.wst.common.modulecore.ModuleCoreNature</nature>

    </natures>
</projectDescription>
